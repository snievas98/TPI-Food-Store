# PostgreSQL recomendado: postgresql://foodstore:foodstore@localhost:5432/foodstore_db
# Para ejecutar sin instalar PostgreSQL: sqlite:///./foodstore.db
DATABASE_URL=sqlite:///./foodstore.db
SECRET_KEY=reemplazar-por-una-clave-aleatoria-de-32-o-mas-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
# true solo detrás de HTTPS (desarrollo HTTP local: false)
COOKIE_SECURE=false
